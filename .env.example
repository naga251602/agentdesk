# Copy to .env and adjust. Everything has a working default.

# Escalate to a human when answer confidence is below this (spec: 0.70)
AGENTDESK_ESCALATION_THRESHOLD=0.70

# Chunking
AGENTDESK_CHUNK_TOKENS=512
AGENTDESK_CHUNK_OVERLAP=64
AGENTDESK_TOP_K=5

# Optional persistence of documents/tickets between restarts (JSON file)
# AGENTDESK_STATE_FILE=data/state.json

# Optional LLM mode — any OpenAI-compatible endpoint.
# vLLM example (GPU host):  LLM_BASE_URL=http://gpu-host:8000/v1
# llama.cpp example:        LLM_BASE_URL=http://localhost:8080/v1
# Leave unset for the built-in offline extractive mode.
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=meta-llama/Llama-3.2-3B-Instruct
